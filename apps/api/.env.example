# Yandex Managed PostgreSQL
# Example: postgres://nexum_user:PASSWORD@c-CLUSTER_ID.rw.mdb.yandexcloud.net:6432/nexum?sslmode=verify-full
NEXUM_DATABASE_URL=
NEXUM_DB_SSL=true
# Optional CA certificate contents/path are deployment-specific. For public Yandex hosts use the Yandex CA certificate.
NEXUM_DB_CA=

# Generate a random value of at least 32 characters and keep it server-side.
NEXUM_AUTH_SECRET=
NEXUM_DB_POOL_MAX=10
