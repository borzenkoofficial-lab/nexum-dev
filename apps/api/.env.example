# Yandex Managed PostgreSQL
# Example: postgres://nexum_user:PASSWORD@c-CLUSTER_ID.rw.mdb.yandexcloud.net:6432/nexum?sslmode=verify-full
NEXUM_DATABASE_URL=
NEXUM_DB_SSL=true
# Optional CA certificate contents/path are deployment-specific. For public Yandex hosts use the Yandex CA certificate.
NEXUM_DB_CA=

# Generate a random value of at least 32 characters and keep it server-side.
NEXUM_AUTH_SECRET=
# Leave blank to use 10 connections locally and 2 on Vercel Functions.
NEXUM_DB_POOL_MAX=

# Authentication and production CORS
# Keep false only for local development; set true in Vercel and provide NEXUM_AUTH_SECRET.
NEXUM_AUTH_ENABLED=false
NEXUM_CORS_ORIGINS=http://localhost:5173

# Real AI provider. Mock AI is not supported.
# In Vercel, do not use localhost Ollama; configure a reachable remote provider and its key.
# Supported: ollama, openrouter, openai, anthropic, orcarouter
AI_PROVIDER=ollama
AI_FALLBACK_PROVIDER=

# AnyModel (OpenAI-compatible gateway)
ANYMODEL_API_KEY=
ANYMODEL_MODEL=gpt-6-astra
ANYMODEL_BASE_URL=https://anymodel.org/v1

# Provider configuration (only configure providers you actually use)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ORCAROUTER_API_KEY=
ORCAROUTER_MODEL=deepseek/deepseek-v4-flash-free
