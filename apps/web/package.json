{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.studio.config.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:runtime": "node --experimental-strip-types --experimental-specifier-resolution=node --test src/runtime/runtime.test.ts",
    "typecheck": "tsc --noEmit",
    "test:brand": "node --experimental-strip-types --experimental-specifier-resolution=node --test src/components/KvardMark.test.ts",
    "test:ui-kit": "node --experimental-strip-types --experimental-specifier-resolution=node --test src/components/ui/ui.test.ts",
    "test:billing": "node --experimental-strip-types --experimental-specifier-resolution=node --test src/components/billingFormat.test.ts",
    "test:ai-stream": "node --experimental-strip-types --experimental-specifier-resolution=node --test src/runtime/AIStream.test.ts",
    "dev:studio": "vite --config vite.studio.config.ts",
    "build:studio": "vite build --config vite.studio.config.ts",
    "test:studio": "node --experimental-strip-types --experimental-specifier-resolution=node --test studio/src/model.test.ts"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
