# NEXUM AI configuration
# Provider used when no route is explicitly selected.
AI_PROVIDER=openrouter

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional providers. Keep keys server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_WORKER_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_OPUS_MODEL=claude-opus-4-8
ORCAROUTER_API_KEY=
ORCAROUTER_MODEL=deepseek/deepseek-v4-flash-free

# Central NEXUM model registry.
# Override model IDs here without changing agent/orchestrator code.
NEXUM_DIRECTOR_PROVIDER=openai
NEXUM_DIRECTOR_MODEL=
NEXUM_BUILDER_PROVIDER=anthropic
NEXUM_BUILDER_MODEL=
NEXUM_DEBUGGER_PROVIDER=anthropic
NEXUM_DEBUGGER_MODEL=
NEXUM_WORKER_PROVIDER=openai
NEXUM_WORKER_MODEL=
NEXUM_CHEAP_WORKER_PROVIDER=orcarouter
NEXUM_CHEAP_WORKER_MODEL=
NEXUM_CODING_WORKER_PROVIDER=openrouter
NEXUM_CODING_WORKER_MODEL=
NEXUM_VISION_PROVIDER=gemini
NEXUM_VISION_MODEL=gemini-3.1-pro
NEXUM_FALLBACK_PROVIDER=orcarouter
NEXUM_FALLBACK_MODEL=

# Optional local fallback
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
