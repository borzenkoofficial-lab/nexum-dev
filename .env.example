# NEXUM production configuration
# Configure these in the deployment platform's secret/environment settings.
NEXUM_DATABASE_URL=
NEXUM_DB_SSL=true
NEXUM_AUTH_ENABLED=true
# Generate a unique random secret of at least 32 characters; never commit its real value.
NEXUM_AUTH_SECRET=
NEXUM_CORS_ORIGINS=

# Optional self-hosted Docker Compose mode only. Leave the URL empty for local sandbox execution.
# API and worker must share the same named volume; the worker alone receives Docker socket access.
NEXUM_SANDBOX_WORKER_URL=
NEXUM_SANDBOX_WORKER_SECRET=
NEXUM_SANDBOX_VOLUME_ROOT=/app/runtime

# NEXUM AI configuration
AI_PROVIDER=anymodel

# AnyModel (OpenAI-compatible gateway)
ANYMODEL_API_KEY=
ANYMODEL_MODEL=gpt-6-astra
ANYMODEL_BASE_URL=https://anymodel.org/v1

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional local fallback
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
