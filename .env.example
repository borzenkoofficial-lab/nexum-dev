# NEXUM production configuration
# Configure these in the deployment platform's secret/environment settings.
NEXUM_DATABASE_URL=
NEXUM_DB_SSL=true
NEXUM_AUTH_ENABLED=true
# Generate a unique random secret of at least 32 characters; never commit its real value.
NEXUM_AUTH_SECRET=
NEXUM_CORS_ORIGINS=
# Comma-separated existing user UUIDs; never use unverified email addresses for admin bootstrap.
# Leave empty to keep all admin access disabled until explicitly configured.
KVARD_SUPER_ADMIN_USER_IDS=

# NEXUM AI configuration
AI_PROVIDER=anymodel

# AnyModel (OpenAI-compatible gateway)
ANYMODEL_API_KEY=
ANYMODEL_MODEL=gpt-6-astra
ANYMODEL_BASE_URL=https://anymodel.org/v1

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Dedicated AES-256-GCM key for persistent platform AI provider credentials.
# Generate a unique random value of at least 32 characters; keep it outside source control.
AI_PROVIDER_ENCRYPTION_KEY=

# Optional local fallback
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
