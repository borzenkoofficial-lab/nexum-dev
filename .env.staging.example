# Copy to .env.staging and replace every placeholder before deployment.
# Generate secrets with: openssl rand -hex 32
NEXUM_DOMAIN=staging.example.com

# PostgreSQL reachable from this Docker host; use a dedicated database.
NEXUM_DATABASE_URL=postgresql://nexum:REPLACE_ME@DB_HOST_REACHABLE_FROM_DOCKER:5432/nexum
NEXUM_DB_SSL=false

# Required production secrets: use independent random values of at least 32 characters.
NEXUM_AUTH_ENABLED=true
NEXUM_AUTH_SECRET=REPLACE_WITH_OUTPUT_OF_OPENSSL_RAND_HEX_32
NEXUM_SANDBOX_WORKER_SECRET=REPLACE_WITH_A_DIFFERENT_OPENSSL_RAND_HEX_32

# AnyModel provider credentials.
ANYMODEL_API_KEY=REPLACE_ME
ANYMODEL_MODEL=gpt-6-astra
ANYMODEL_BASE_URL=https://anymodel.org/v1

# Optional production tuning.
NEXUM_SANDBOX_AUTO_PULL=false
NEXUM_SANDBOX_WORKER_PORT=3020
