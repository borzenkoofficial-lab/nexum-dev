# Copy to .env.staging on the server. Never commit real secrets.
NEXUM_DOMAIN=staging.example.ru

# AI provider: orcarouter | openrouter | openai | anthropic | ollama | mock
AI_PROVIDER=orcarouter

# Optional provider keys. Put real values ONLY on the server.
ORCAROUTER_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional database.
NEXUM_DATABASE_URL=

# Optional model overrides.
ORCAROUTER_MODEL=
OPENROUTER_MODEL=
OPENAI_MODEL=
ANTHROPIC_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
