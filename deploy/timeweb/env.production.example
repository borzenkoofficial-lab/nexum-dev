# Copy to .env.production on the VPS. Never commit real values.
# Timeweb Managed PostgreSQL connection string (use the cluster's host/database/user).
NEXUM_DATABASE_URL=
NEXUM_DB_SSL=true
# Optional PEM CA contents if the cluster requires a custom CA.
NEXUM_DB_CA=
NEXUM_DB_POOL_MAX=10

# Production authentication
NEXUM_AUTH_ENABLED=true
NEXUM_AUTH_SECRET=

# Public origin of KVARD. Keep the exact scheme and hostname.
NEXUM_CORS_ORIGINS=https://kvard.example.com

# AI provider: configure a real provider and its key.
AI_PROVIDER=anymodel
ANYMODEL_API_KEY=
ANYMODEL_MODEL=gpt-6-astra
ANYMODEL_BASE_URL=https://anymodel.org/v1
AI_FALLBACK_PROVIDER=

# Encryption key for provider credentials stored in PostgreSQL (at least 32 characters).
AI_PROVIDER_ENCRYPTION_KEY=

# Base64-encoded 32-byte key for durable encrypted Agent execution checkpoints.
KVARD_AGENT_CHECKPOINT_ENCRYPTION_KEY=

# Production Builder sandbox. Docker-in-Docker is intentionally not enabled.
NEXUM_SANDBOX_PROVIDER=daytona
DAYTONA_API_KEY=
